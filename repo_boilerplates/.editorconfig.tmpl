# root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 79
guidelines = 72 dashed, 79  # VSCode only, with guidelines plugin
# tab_width = 4

[{*.bash,*.sh,*.zsh}]
indent_size = 2
# tab_width = 2

[{*.har,*.jsb2,*.jsb3,*.json,*.jsonc,*.postman_collection,*.postman_collection.json,*.postman_environment,*.postman_environment.json,.babelrc,.eslintrc,.prettierrc,.stylelintrc,.ws-context,jest.config}]
indent_size = 2

[{*.r,*.rprofile}]
indent_size = 4

[{*.yaml,*.yml,dbt_project.yml,environment.yaml,environment.yml}]
indent_size = 2
